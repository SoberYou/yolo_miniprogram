page {
  background-color: #f5f6fa;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: transparent;
}

/* Custom Header */
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding-left: 24px; /* Align with content */
  position: relative;
}

.app-title {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #000000;
}

.main-content {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
}

.scroll-container {
  padding: 16px;
}

/* Card Module Style */
.card-module {
  background-color: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}

/* Top Tabs */
.top-tabs {
  display: flex;
  padding: 0;
  height: 44px;
  align-items: center;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 15px;
  color: #666;
  position: relative;
  height: 100%;
  line-height: 44px;
  transition: all 0.3s;
}

.tab.active {
  color: #000;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  background-color: #000;
  border-radius: 2px;
}

/* Period Module */
.period-module {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
}

.period-btn {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #666;
  padding: 6px 0;
  border-radius: 6px;
  transition: all 0.2s;
}

.period-btn.active {
  background-color: #f0f0f0;
  color: #000;
  font-weight: 500;
}

/* Date Picker Module */
.date-picker-module {
  box-sizing: border-box;
  height: 68px;
  padding: 16px;
  margin-bottom: 8px;
  position: sticky;
  top: 12px;
  z-index: 80;
  background: #fff;
  border: 1px solid #eeeeee;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transform: translateZ(0);
}

.date-picker-module::before,
.date-picker-module::after {
  content: '';
  position: absolute;
  left: -16px;
  right: -16px;
  background: #f5f6fa;
  pointer-events: none;
}

.date-picker-module::before {
  top: -14px;
  height: 14px;
}

.date-picker-module::after {
  bottom: -9px;
  height: 9px;
}

.config-sticky-mask {
  position: sticky;
  top: 80px;
  height: 8px;
  background: #f5f6fa;
  z-index: 75;
}

/* Date Range Module (Analysis) */
.date-range-module {
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  height: 68px;
  padding: 16px;
  margin-bottom: 8px;
  position: sticky;
  top: 12px;
  z-index: 90;
  background: #fff;
  border: 1px solid #eeeeee;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transform: translateZ(0);
}

.date-range-module::before,
.date-range-module::after {
  content: '';
  position: absolute;
  left: -16px;
  right: -16px;
  background: #f5f6fa;
  pointer-events: none;
}

.date-range-module::before {
  top: -14px;
  height: 14px;
}

.date-range-module::after {
  bottom: -9px;
  height: 9px;
}

.range-picker {
  flex: 1;
  text-align: center;
}

.range-separator {
  color: #999;
  font-size: 14px;
  margin: 0 10px;
}

/* Analysis Chart Module */
.analysis-chart-module {
  box-sizing: border-box;
  height: 202px;
  padding: 20px 16px;
  margin-bottom: 8px;
  position: sticky;
  top: 88px;
  z-index: 80;
  background: #fff;
  border: 1px solid #eeeeee;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transform: translateZ(0);
}

.analysis-chart-module::after {
  content: '';
  position: absolute;
  left: -16px;
  right: -16px;
  bottom: -9px;
  height: 9px;
  background: #f5f6fa;
  pointer-events: none;
}

.chart-header {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 20px;
  text-align: center;
}

.chart-body {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 120px;
}

.pie-container {
  position: relative;
  width: 120px;
  height: 120px;
}

.pie-chart {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  /* background comes from inline style */
}

.pie-center {
  position: absolute;
  top: 15px;
  left: 15px;
  width: 90px;
  height: 90px;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.pie-total {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.pie-label {
  font-size: 12px;
  color: #999;
}

.legend-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 6px 12px;
  border-radius: 6px;
  transition: background-color 0.2s;
}

.legend-item.active-legend {
  background-color: #f0f0f0;
}

.legend-color {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  margin-right: 8px;
}

.legend-text {
  font-size: 14px;
  color: #666;
}

/* Analysis List Module */
.analysis-list-module {
  padding: 16px;
  position: relative;
  z-index: 70;
  overflow: visible;
  background: #fff;
  border: 1px solid #eeeeee;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.list-header {
  font-size: 15px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #f0f0f0;
}

.analysis-list-module .list-header {
  position: sticky;
  top: 314px;
  z-index: 85;
  background: #fff;
  box-shadow: 0 -16px 0 #fff, 0 8px 0 #fff;
  transform: translateZ(0);
}

.analysis-list-module .list-header::before,
.analysis-list-module .list-header::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}

.analysis-list-module .list-header::before {
  top: -16px;
  height: 16px;
  background: #fff;
}

.analysis-list-module .list-header::after {
  bottom: -8px;
  height: 8px;
  background: #fff;
}

.todo-date-tag {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 12px;
  color: #999;
}

.analysis-list-module .todo-item {
  padding-right: 80px; /* space for date tag */
}

.date-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 100%;
}

.current-date-picker {
  flex: 1;
  text-align: center;
}

.date-display {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.date-text {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.side-date {
  flex: 0 0 80px;
  font-size: 13px;
  color: #aaa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prev-date {
  text-align: left;
}

.next-date {
  text-align: right;
}

/* Todo List Module */
.todo-list-module {
  padding: 16px;
  min-height: 200px;
  position: relative;
  overflow: visible;
  background: #fff;
  z-index: 40;
}

.add-todo-container {
  display: flex;
  align-items: center;
  padding: 8px 0 16px;
  border-bottom: 1px solid #f5f5f5;
  margin-bottom: 8px;
  position: sticky;
  top: 88px;
  z-index: 70;
  background: #fff;
  box-shadow: 0 -20px 0 #fff, 0 8px 0 #fff;
}

.add-todo-container::before,
.add-todo-container::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}

.add-todo-container::before {
  top: -18px;
  height: 18px;
  background: #fff;
}

.add-todo-container::after {
  bottom: -12px;
  height: 12px;
  background: linear-gradient(to bottom, #fff, rgba(255, 255, 255, 0));
}

.disabled-checkbox {
  border-color: #eee;
  background-color: #fafafa;
}

.add-todo-input {
  flex: 1;
  font-size: 15px;
  color: #333;
  margin-right: 12px;
  height: 36px;
}

.add-todo-btn {
  font-size: 14px;
  color: #fff;
  background-color: #000;
  padding: 6px 16px;
  border-radius: 16px;
  transition: all 0.2s;
}

.add-todo-btn.btn-hover {
  opacity: 0.8;
}

.todo-item-container {
  position: relative;
  width: 100%;
  margin-bottom: 12px;
  overflow: visible; /* 修改为 visible 允许滑动层露出 */
  border-radius: 8px;
  background: #ff4d4f; /* 底层红色，用于滑动删除 */
  transition: transform 0.2s ease;
}

.todo-item-container.dragging-item {
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  transition: none; /* 拖拽时取消过渡，跟随手指 */
}

.todo-item-container:last-child {
  border-bottom: none;
}

.todo-item-wrapper {
  width: 100%;
  background-color: #fff;
  transition: transform 0.2s ease-out;
  z-index: 2;
  position: relative;
}

.todo-item {
  display: flex;
  align-items: flex-start;
  padding: 12px 0;
  transition: background-color 0.2s;
  min-height: 24px;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 70px;
  height: 100%;
  background-color: #ff3b30;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  z-index: 1;
}

.todo-item:active {
  background-color: #f9f9f9;
}

.checkbox {
  width: 20px;
  height: 20px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-right: 12px;
  position: relative;
  flex-shrink: 0;
  margin-top: 2px;
}

.checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  top: 3px;
  left: 6px;
  width: 5px;
  height: 10px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.icon-do {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background-color: #07c160;
  position: relative;
  margin-right: 12px;
  flex-shrink: 0;
  margin-top: 2px;
}

.icon-do::after {
  content: '';
  position: absolute;
  top: 4px;
  left: 7px;
  width: 4px;
  height: 8px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.icon-not-do {
  width: 20px;
  height: 20px;
  border: 2px solid #ff4d4f;
  border-radius: 50%;
  position: relative;
  margin-right: 12px;
  flex-shrink: 0;
  margin-top: 2px;
  box-sizing: border-box;
}

.icon-not-do::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14px;
  height: 2px;
  background-color: #ff4d4f;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.todo-content {
  font-size: 15px;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.inline-edit-input {
  flex: 1;
  font-size: 15px;
  color: #333;
  min-height: 24px;
  line-height: 1.5;
  border-bottom: 1px solid #000;
  padding: 0;
  margin: 0;
  width: 100%;
}

.completed-text {
  color: #999;
  text-decoration: line-through;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 14px;
  padding: 40px 0;
}

.action-tip {
  text-align: center;
  font-size: 12px;
  color: #ccc;
  margin-top: 16px;
}