<view class="container" style="padding-top: {{navBarHeight + statusBarHeight}}px; box-sizing: border-box;">
  <!-- Custom Header -->
  <view class="custom-header" style="height: {{navBarHeight + statusBarHeight}}px; padding-top: {{statusBarHeight}}px; box-sizing: border-box;">
    <view class="header-content" style="height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px; margin-top: {{menuButtonTop - statusBarHeight}}px;">
      <text class="app-title">YOU ONLY LIVE ONCE</text>
    </view>
  </view>
  
  <scroll-view class="main-content" scroll-y="true" style="padding-bottom: 80px; position: absolute; top: {{navBarHeight + statusBarHeight}}px; bottom: 0;" bounces="{{false}}">
    <view class="scroll-container">
      <!-- 顶部 配置/分析 Tabs -->
      <view class="card-module tabs-module top-tabs">
        <view class="tab {{currentTopTab === 'config' ? 'active' : ''}}" bindtap="switchTopTab" data-tab="config">配置</view>
        <view class="tab {{currentTopTab === 'analysis' ? 'active' : ''}}" bindtap="switchTopTab" data-tab="analysis">分析</view>
      </view>

      <!-- 日/周/月/年 选项模块 -->
      <view class="card-module period-module">
        <view class="period-btn {{currentPeriod === 'day' ? 'active' : ''}}" bindtap="switchPeriod" data-period="day">日</view>
        <view class="period-btn {{currentPeriod === 'week' ? 'active' : ''}}" bindtap="switchPeriod" data-period="week">周</view>
        <view class="period-btn {{currentPeriod === 'month' ? 'active' : ''}}" bindtap="switchPeriod" data-period="month">月</view>
        <view class="period-btn {{currentPeriod === 'year' ? 'active' : ''}}" bindtap="switchPeriod" data-period="year">年</view>
      </view>

      <!-- 日期选择模块 -->
      <view class="card-module date-picker-module">
        <picker mode="date" value="{{currentDateStr}}" bindchange="onDateChange">
          <view class="date-display">
            <text class="calendar-icon">📅</text>
            <text class="date-text">{{currentDateStr}}</text>            
          </view>
        </picker>
      </view>

      <!-- TODO 事项列表 -->
      <view class="card-module todo-list-module">
        <!-- 添加待办 -->
        <view class="add-todo-container">
          <view class="checkbox disabled-checkbox"></view>
          <input class="add-todo-input" placeholder="添加待办事项..." value="{{newTodoContent}}" bindinput="onNewTodoInput" bindconfirm="addTodo" confirm-type="done" />
          <view class="add-todo-btn" bindtap="addTodo" hover-class="btn-hover">添加</view>
        </view>

        <block wx:if="{{todos.length > 0}}">
          <view class="todo-item-container" wx:for="{{todos}}" wx:key="id">
            <view class="todo-item-wrapper" 
                  style="transform: translateX({{item.slideOffset || 0}}px);" 
                  bindtouchstart="touchStart" 
                  bindtouchmove="touchMove" 
                  bindtouchend="touchEnd" 
                  data-index="{{index}}"
                  data-item="{{item}}">
              
              <view class="todo-item" data-item="{{item}}" bindtap="startEdit">
                <view class="checkbox {{item.isCompleted === 1 ? 'checked' : ''}}" catchtap="toggleTodo" data-item="{{item}}"></view>
                
                <textarea wx:if="{{editingTodoId === item.id}}" 
                       class="inline-edit-input" 
                       value="{{editTodoContent}}" 
                       focus="{{focusId === item.id}}" 
                       auto-height="true"
                       cursor-spacing="20"
                       show-confirm-bar="{{false}}"
                       catchtap="preventTap"
                       bindinput="onEditTodoInput" 
                       bindblur="finishEdit" 
                       bindconfirm="finishEdit" 
                       confirm-type="done"
                       data-item="{{item}}" />
                
                <text wx:else class="todo-content {{item.isCompleted === 1 ? 'completed-text' : ''}}">{{item.content}}</text>
              </view>
            </view>
            
            <view class="delete-btn" bindtap="promptDelete" data-item="{{item}}">
              删除
            </view>
          </view>
          <view class="action-tip">点击文字修改待办，左滑删除待办</view>
        </block>
        <view class="empty-tip" wx:else>暂无待办事项</view>
      </view>
    </view>
  </scroll-view>
</view>