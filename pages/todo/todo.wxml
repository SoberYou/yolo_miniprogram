<page-meta page-style="{{isDragging ? 'overflow: hidden;' : ''}}" />
<view class="container" style="padding-top: {{navBarHeight + statusBarHeight}}px; box-sizing: border-box; --nav-height: {{navBarHeight + statusBarHeight}}px;">
  <!-- Custom Header -->
  <view class="custom-header" style="height: {{navBarHeight + statusBarHeight}}px; padding-top: {{statusBarHeight}}px; box-sizing: border-box;">
    <view class="header-content" style="height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px; margin-top: {{menuButtonTop - statusBarHeight}}px;">
      <text class="app-title">YOU ONLY LIVE ONCE</text>
    </view>
  </view>
  
  <scroll-view class="main-content {{currentTopTab === 'donotdo' ? 'donotdo-fixed-content' : ''}}" scroll-y="{{currentTopTab !== 'donotdo'}}" style="padding-bottom: {{currentTopTab === 'donotdo' ? 0 : 80}}px; position: absolute; top: {{navBarHeight + statusBarHeight}}px; bottom: {{currentTopTab === 'donotdo' ? 80 : 0}}px;" bounces="{{false}}">
    <view class="scroll-container {{currentTopTab === 'donotdo' ? 'donotdo-scroll-container' : ''}}">
      <!-- 顶部 配置/分析/做不做清单 Tabs -->
      <view class="card-module tabs-module top-tabs">
        <view class="tab {{currentTopTab === 'config' ? 'active' : ''}}" bindtap="switchTopTab" data-tab="config">配置</view>
        <view class="tab {{currentTopTab === 'analysis' ? 'active' : ''}}" bindtap="switchTopTab" data-tab="analysis">分析</view>
        <view class="tab {{currentTopTab === 'donotdo' ? 'active' : ''}}" bindtap="switchTopTab" data-tab="donotdo">做不做清单</view>
      </view>

      <!-- 日/周/月/年 选项模块 -->
      <view class="card-module period-module" wx:if="{{currentTopTab !== 'donotdo'}}">
        <view class="period-btn {{currentPeriod === 'day' ? 'active' : ''}}" bindtap="switchPeriod" data-period="day">日</view>
        <view class="period-btn {{currentPeriod === 'month' ? 'active' : ''}}" bindtap="switchPeriod" data-period="month">月</view>
      </view>

      <view class="card-module donotdo-sub-tabs" wx:if="{{currentTopTab === 'donotdo'}}">
        <view class="donotdo-sub-tab {{currentDonotdoTab === 'do' ? 'active' : ''}}" bindtap="switchDonotdoTab" data-tab="do">做清单</view>
        <view class="donotdo-sub-tab {{currentDonotdoTab === 'notDo' ? 'active' : ''}}" bindtap="switchDonotdoTab" data-tab="notDo">不做清单</view>
      </view>

      <!-- 日期选择模块 (配置Tab下显示) -->
      <view class="card-module date-picker-module" wx:if="{{currentTopTab === 'config'}}"
            bindtouchstart="dateTouchStart" 
            bindtouchend="dateTouchEnd">
        <view class="date-navigation">
          <view class="side-date prev-date" bindtap="prevDate">
            <text>{{prevDateText}}</text>
          </view>
          
          <picker class="current-date-picker" mode="date" fields="{{pickerFields}}" value="{{currentDateStr}}" bindchange="onDateChange">
            <view class="date-display">
              <text class="date-text">{{dateDisplayText}}</text>            
            </view>
          </picker>
          
          <view class="side-date next-date" bindtap="nextDate">
            <text>{{nextDateText}}</text>
          </view>
        </view>
      </view>
      <view class="config-sticky-mask" wx:if="{{currentTopTab === 'config'}}"></view>

      <!-- 分析模块：日期范围选择 -->
      <view class="card-module date-range-module" wx:if="{{currentTopTab === 'analysis'}}">
        <picker class="range-picker" mode="date" fields="{{pickerFields}}" value="{{analysisStartStr}}" bindchange="onAnalysisStartChange">
          <view class="range-display">
            <text class="date-text">{{analysisStartDisplay}}</text>
          </view>
        </picker>
        <text class="range-separator">至</text>
        <picker class="range-picker" mode="date" fields="{{pickerFields}}" value="{{analysisEndStr}}" bindchange="onAnalysisEndChange">
          <view class="range-display">
            <text class="date-text">{{analysisEndDisplay}}</text>
          </view>
        </picker>
      </view>

      <!-- 分析模块：图表统计 -->
      <view class="card-module analysis-chart-module" wx:if="{{currentTopTab === 'analysis'}}">
        <view class="chart-header">任务完成情况</view>
        <view class="chart-body">
          <view class="pie-container">
            <view class="pie-chart" style="background: {{totalCount === 0 ? '#f0f0f0' : 'conic-gradient(#07c160 0% ' + donePercent + '%, #ff4d4f ' + donePercent + '% 100%)'}};"></view>
            <view class="pie-center">
              <text class="pie-total">{{totalCount}}</text>
              <text class="pie-label">总数</text>
            </view>
          </view>
          <view class="legend-container">
            <view class="legend-item {{analysisFilterStatus === 'done' ? 'active-legend' : ''}}" bindtap="filterAnalysis" data-status="done">
              <view class="legend-color" style="background: #07c160;"></view>
              <text class="legend-text">已完成 {{doneCount}} ({{donePercent}}%)</text>
            </view>
            <view class="legend-item {{analysisFilterStatus === 'undo' ? 'active-legend' : ''}}" bindtap="filterAnalysis" data-status="undo">
              <view class="legend-color" style="background: #ff4d4f;"></view>
              <text class="legend-text">未完成 {{undoCount}} ({{undoPercent}}%)</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 分析模块：过滤后的列表展示 -->
      <view class="card-module analysis-list-module" wx:if="{{currentTopTab === 'analysis' && analysisFilterStatus}}">
        <view class="list-header">{{analysisFilterStatus === 'done' ? '已完成事项' : '未完成事项'}}</view>
        <block wx:if="{{filteredAnalysisTodos.length > 0}}">
          <view class="todo-item-container" wx:for="{{filteredAnalysisTodos}}" wx:key="id" style="margin-bottom: 8px;">
            <view class="todo-item-wrapper" style="transform: translateX(0px);">
              <view class="todo-item">
                <view class="checkbox {{item.isCompleted === 1 ? 'checked' : 'disabled-checkbox'}}"></view>
                <text class="todo-content {{item.isCompleted === 1 ? 'completed-text' : ''}}">{{item.content}}</text>
              </view>
              <view class="todo-date-tag">{{item.startDate}}</view>
            </view>
          </view>
        </block>
        <view class="empty-tip" wx:else>暂无相关事项</view>
      </view>

      <!-- TODO 事项列表 -->
      <view class="card-module todo-list-module" wx:if="{{currentTopTab === 'config'}}">
        <!-- 添加待办 -->
        <view class="add-todo-container">
          <view class="checkbox disabled-checkbox"></view>
          <input class="add-todo-input" placeholder="添加待办事项..." value="{{newTodoContent}}" bindinput="onNewTodoInput" bindconfirm="addTodo" confirm-type="done" />
          <view class="add-todo-btn" bindtap="addTodo" hover-class="btn-hover">添加</view>
        </view>

        <block wx:if="{{todos.length > 0}}">
          <view class="todo-item-container {{draggingId === item.id ? 'dragging-item' : ''}}" 
                wx:for="{{todos}}" 
                wx:key="id"
                style="{{draggingId === item.id ? 'transform: translateY(' + dragTranslateY + 'px); z-index: 99;' : 'transform: translateY(0px); z-index: 1;'}}">
            <view class="todo-item-wrapper" 
                  style="transform: translateX({{item.slideOffset || 0}}px);" 
                  bindtouchstart="touchStart" 
                  bindtouchmove="touchMove" 
                  bindtouchend="touchEnd" 
                  bindlongpress="longPress"
                  data-index="{{index}}"
                  data-item="{{item}}">
              
              <view class="todo-item" data-item="{{item}}" bindtap="startEdit">
                <view class="checkbox {{item.isCompleted === 1 ? 'checked' : ''}}" catchtap="toggleTodo" data-item="{{item}}"></view>
                
                <textarea wx:if="{{editingTodoId === item.id}}" 
                       class="inline-edit-input" 
                       value="{{editTodoContent}}" 
                       focus="{{focusId === item.id}}" 
                       auto-height="true"
                       cursor-spacing="20"
                       show-confirm-bar="{{false}}"
                       catchtap="preventTap"
                       bindinput="onEditTodoInput" 
                       bindblur="finishEdit" 
                       bindconfirm="finishEdit" 
                       confirm-type="done"
                       data-item="{{item}}" />
                
                <text wx:else class="todo-content {{item.isCompleted === 1 ? 'completed-text' : ''}}">{{item.content}}</text>
              </view>
            </view>
            
            <view class="delete-btn" bindtap="promptDelete" data-item="{{item}}">
              删除
            </view>
          </view>
          <view class="action-tip">点击修改，左滑删除，长按拖拽排序</view>
        </block>
        <view class="empty-tip" wx:else>暂无待办事项</view>
      </view>

      <!-- 做不做清单：做清单 -->
      <view class="card-module todo-list-module" wx:if="{{currentTopTab === 'donotdo' && currentDonotdoTab === 'do'}}">
        <view class="list-header" style="padding: 16px 20px 8px;">做清单</view>
        <view class="add-todo-container">
          <input class="add-todo-input" placeholder="添加做清单..." value="{{newDoContent}}" bindinput="onNewDoInput" bindconfirm="addDoItem" confirm-type="done" />
          <view class="add-todo-btn" bindtap="addDoItem" hover-class="btn-hover" style="background: #07c160; color: white;">添加</view>
        </view>

        <scroll-view class="donotdo-list-body" scroll-y="true" bounces="{{false}}">
          <block wx:if="{{doList.length > 0}}">
            <view class="todo-item-container {{draggingId === item.id ? 'dragging-item' : ''}}" 
                  wx:for="{{doList}}" 
                  wx:key="id"
                  style="{{draggingId === item.id ? 'transform: translateY(' + dragTranslateY + 'px); z-index: 99;' : 'transform: translateY(0px); z-index: 1;'}}">
              <view class="todo-item-wrapper" 
                    style="transform: translateX({{item.slideOffset || 0}}px);" 
                    bindtouchstart="touchStart" 
                    bindtouchmove="touchMove" 
                    bindtouchend="touchEnd" 
                    bindlongpress="longPress"
                    data-index="{{index}}"
                    data-item="{{item}}"
                    data-listtype="DO">
                
                <view class="todo-item" data-item="{{item}}" data-listtype="DO" bindtap="startEdit">
                  <view class="icon-do"></view>
                  <textarea wx:if="{{editingTodoId === item.id}}" 
                         class="inline-edit-input" 
                         value="{{editTodoContent}}" 
                         focus="{{focusId === item.id}}" 
                         auto-height="true"
                         cursor-spacing="20"
                         show-confirm-bar="{{false}}"
                         catchtap="preventTap"
                         bindinput="onEditTodoInput" 
                         bindblur="finishEdit" 
                         bindconfirm="finishEdit" 
                         confirm-type="done"
                         data-item="{{item}}"
                         data-listtype="DO" />
                  
                  <text wx:else class="todo-content">{{item.content}}</text>
                </view>
              </view>
              
              <view class="delete-btn" bindtap="promptDelete" data-item="{{item}}" data-listtype="DO">
                删除
              </view>
            </view>
          </block>
          <view class="empty-tip" wx:else>暂无做清单事项</view>
        </scroll-view>
      </view>

      <!-- 做不做清单：不做清单 -->
      <view class="card-module todo-list-module" wx:if="{{currentTopTab === 'donotdo' && currentDonotdoTab === 'notDo'}}">
        <view class="list-header" style="padding: 16px 20px 8px;">不做清单</view>
        <view class="add-todo-container">
          <input class="add-todo-input" placeholder="添加不做清单..." value="{{newNotDoContent}}" bindinput="onNewNotDoInput" bindconfirm="addNotDoItem" confirm-type="done" />
          <view class="add-todo-btn" bindtap="addNotDoItem" hover-class="btn-hover" style="background: #ff4d4f; color: white;">添加</view>
        </view>

        <scroll-view class="donotdo-list-body" scroll-y="true" bounces="{{false}}">
          <block wx:if="{{notDoList.length > 0}}">
            <view class="todo-item-container {{draggingId === item.id ? 'dragging-item' : ''}}" 
                  wx:for="{{notDoList}}" 
                  wx:key="id"
                  style="{{draggingId === item.id ? 'transform: translateY(' + dragTranslateY + 'px); z-index: 99;' : 'transform: translateY(0px); z-index: 1;'}}">
              <view class="todo-item-wrapper" 
                    style="transform: translateX({{item.slideOffset || 0}}px);" 
                    bindtouchstart="touchStart" 
                    bindtouchmove="touchMove" 
                    bindtouchend="touchEnd" 
                    bindlongpress="longPress"
                    data-index="{{index}}"
                    data-item="{{item}}"
                    data-listtype="NOT_DO">
                
                <view class="todo-item" data-item="{{item}}" data-listtype="NOT_DO" bindtap="startEdit">
                  <view class="icon-not-do"></view>
                  <textarea wx:if="{{editingTodoId === item.id}}" 
                         class="inline-edit-input" 
                         value="{{editTodoContent}}" 
                         focus="{{focusId === item.id}}" 
                         auto-height="true"
                         cursor-spacing="20"
                         show-confirm-bar="{{false}}"
                         catchtap="preventTap"
                         bindinput="onEditTodoInput" 
                         bindblur="finishEdit" 
                         bindconfirm="finishEdit" 
                         confirm-type="done"
                         data-item="{{item}}"
                         data-listtype="NOT_DO" />
                  
                  <text wx:else class="todo-content">{{item.content}}</text>
                </view>
              </view>
              
              <view class="delete-btn" bindtap="promptDelete" data-item="{{item}}" data-listtype="NOT_DO">
                删除
              </view>
            </view>
          </block>
          <view class="empty-tip" wx:else>暂无不做清单事项</view>
        </scroll-view>
      </view>

    </view>
  </scroll-view>
</view>