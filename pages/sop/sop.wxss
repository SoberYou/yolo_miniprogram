page {
  background-color: #f5f6f8;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f6f8;
}

/* Custom Header */
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding-left: 24px; /* Align with content */
  position: relative;
}

.app-title {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #000000;
}

.main-content {
  flex: 1;
  padding: 20px;
}

/* Top Action Bar */
.top-action-bar {
  display: flex;
  flex-direction: column;
  padding: 12px 16px;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}

.action-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  width: 100%;
}

.action-row-secondary {
  margin-bottom: 8px;
}

.action-row:last-child {
  margin-bottom: 0;
}

.label-box {
  font-size: 15px;
  color: #333;
  width: 76px;
  font-weight: bold;
}

.picker-box {
  flex: 1;
  height: 32px;
  border: 1px solid #ddd;
  border-radius: 4px;
  display: flex;
  align-items: center;
  padding: 0 8px;
  margin-right: 12px;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  font-size: 14px;
  color: #333;
}

.dropdown-icon {
  font-size: 12px;
  color: #999;
  margin-left: 6px;
}

.btn-create {
  font-size: 14px;
  color: #fff;
  background-color: #07c160;
  padding: 6px 12px;
  border-radius: 4px;
  white-space: nowrap;
}

.btn-add-cat {
  font-size: 14px;
  color: #07c160;
  border: 1px solid #07c160;
  padding: 5px 12px;
  border-radius: 4px;
  white-space: nowrap;
}

.value-box {
  flex: 1;
  font-size: 15px;
  color: #333;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  margin-right: 12px;
}

.name-text {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}

/* Template Body */
.template-body {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
}

.tip-text {
  font-size: 12px;
  color: #999;
  margin-left: 8px;
  white-space: nowrap;
}