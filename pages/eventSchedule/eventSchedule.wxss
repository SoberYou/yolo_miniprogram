page {
  background-color: #f5f6fa;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', sans-serif;
  height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding-left: 24px;
}

.app-title {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  color: #000000;
}

.main-content {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
}

.scroll-container {
  padding: 16px;
}

.fixed-content {
  overflow: hidden;
}

.fixed-scroll-container {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.view-fixed-content {
  overflow: hidden;
}

.view-scroll-container {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.card-module {
  background-color: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}

.top-tabs {
  display: flex;
  padding: 0;
  height: 44px;
  align-items: center;
  flex-shrink: 0;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 15px;
  color: #666;
  position: relative;
  height: 100%;
  line-height: 44px;
}

.tab.active {
  color: #000;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  background-color: #000;
  border-radius: 2px;
}

.sticky-view-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.filter-module {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: nowrap;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.range-picker {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.range-display,
.date-input,
.time-picker {
  background: #f7f7f7;
  border-radius: 8px;
  padding: 10px 6px;
  font-size: 13px;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.range-separator {
  color: #999;
  font-size: 13px;
}

.refresh-btn,
.primary-btn,
.small-btn {
  background-color: #000;
  color: #fff;
  border-radius: 16px;
  padding: 7px 10px;
  font-size: 13px;
  text-align: center;
  flex-shrink: 0;
}

.toggle-time-btn {
  background-color: #666;
}

.primary-btn {
  margin-top: 14px;
  border-radius: 20px;
  padding: 10px 0;
  font-size: 15px;
}

.schedule-module {
  padding: 12px;
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  margin-bottom: 0;
}

.schedule-scroll {
  width: 100%;
  height: 100%;
  position: relative;
}

.schedule-table {
  min-width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
}

.schedule-row {
  display: flex;
  min-height: 64px;
  border-bottom: 1px solid #f0f0f0;
}

.header-row {
  min-height: 48px;
  background: #fafafa;
  border-radius: 8px 8px 0 0;
  position: relative;
  z-index: 35;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.schedule-body-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.header-cell {
  font-weight: 600;
  color: #333;
}

.time-cell {
  width: 104px;
  flex-shrink: 0;
  padding: 10px 6px;
  box-sizing: border-box;
  font-size: 12px;
  color: #666;
  background: #fff;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sticky-time-cell {
  position: sticky;
  left: 0;
  z-index: 20;
  border-right: 1px solid #f0f0f0;
}

.header-row .sticky-time-cell {
  z-index: 40;
  background: #fafafa;
}

.date-cell {
  width: 118px;
  flex-shrink: 0;
  padding: 8px 5px;
  box-sizing: border-box;
  border-left: 1px solid #f5f5f5;
  font-size: 13px;
}

.date-sub {
  display: block;
  color: #999;
  font-size: 11px;
  margin-top: 2px;
}

.group-title {
  padding: 8px 6px;
  font-size: 12px;
  color: #999;
  background: #fafafa;
}

.current-row {
  background: #fffbea;
}

.event-card {
  border-radius: 8px;
  background: #f4f6f8;
  padding: 8px;
  margin-bottom: 6px;
  border-left: 3px solid #bbb;
}

.event-card.done {
  background: #f0fff5;
  border-left-color: #07c160;
}

.event-card.expired {
  background: #fff1f0;
  border-left-color: #ff4d4f;
}

.event-card.pending {
  background: #f7f7f7;
  border-left-color: #999;
}

.event-name {
  font-size: 13px;
  font-weight: 600;
  color: #333;
  word-break: break-all;
}

.event-time,
.event-status,
.event-meta {
  color: #888;
  font-size: 11px;
  margin-top: 4px;
}

.event-status.editing-time {
  color: #07c160;
  font-weight: 600;
}

.form-module {
  flex-shrink: 0;
}

.form-module .input {
  height: 40px;
  background: #f7f7f7;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 14px;
  margin-bottom: 10px;
}

.form-row {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
}

.form-row .time-picker {
  flex: 1;
  text-align: center;
}

.list-module {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-bottom: 0;
}

.list-header {
  flex-shrink: 0;
  background: #fff;
  z-index: 2;
  font-size: 15px;
  font-weight: bold;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #f0f0f0;
}

.event-list-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.event-row-container {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid #f5f5f5;
}

.event-row {
  padding: 12px 0;
  border-bottom: 1px solid #f5f5f5;
  background: #fff;
}

.event-row-container .event-row {
  border-bottom: none;
}

.swipe-row {
  position: relative;
  z-index: 2;
  transition: transform 0.2s ease;
}

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 180px;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
  background: #fafafa;
  z-index: 1;
}

.swipe-actions .small-btn {
  width: 60px;
  height: 100%;
  padding: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
}

.swipe-actions .swipe-rename {
  background: #2f80ed;
}

.swipe-actions .swipe-archive {
  background: #f5a623;
}

.swipe-actions .swipe-delete {
  background: #ff3b30;
}

.event-row:last-child {
  border-bottom: none;
}

.event-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.row-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

.small-btn {
  padding: 5px 12px;
  background: #333;
}

.small-btn.danger {
  background: #ff4d4f;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 14px;
  padding: 36px 0;
}

