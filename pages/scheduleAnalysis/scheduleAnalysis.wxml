<!--pages/scheduleAnalysis/scheduleAnalysis.wxml-->
<view class="container" style="padding-top: {{navBarHeight + statusBarHeight}}px; box-sizing: border-box; --nav-height: {{navBarHeight + statusBarHeight}}px;">
  <!-- Custom Header -->
  <view class="custom-header" style="height: {{navBarHeight + statusBarHeight}}px; padding-top: {{statusBarHeight}}px; box-sizing: border-box;">
    <view class="header-content" style="height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px; margin-top: {{menuButtonTop - statusBarHeight}}px;">
      <text class="app-title">YOU ONLY LIVE ONCE</text>
    </view>
  </view>

  <scroll-view class="main-content" scroll-y="true" style="padding-bottom: 80px; position: absolute; top: {{navBarHeight + statusBarHeight}}px; bottom: 0;" bounces="{{false}}">
    <view class="scroll-container">
      <!-- Date Range Section -->
      <view class="card-module date-module">
      <view class="date-section-vertical">
        <scroll-view scroll-x="true" class="quick-dates-scroll" enable-flex="true">
          <view class="quick-dates">
            <view class="quick-btn {{currentQuickDate === 'yesterday' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="yesterday">昨天</view>
            <view class="quick-btn {{currentQuickDate === 'today' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="today">今天</view>
            <view class="quick-btn {{currentQuickDate === 'tomorrow' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="tomorrow">明天</view>
            <view class="quick-btn {{currentQuickDate === 'last7days' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="last7days">近7天</view>
            <view class="quick-btn {{currentQuickDate === 'week' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="week">本周</view>
            <view class="quick-btn {{currentQuickDate === 'month' ? 'active' : ''}}" bindtap="selectQuickDate" data-type="month">本月</view>
          </view>
        </scroll-view>
        <view class="left-controls">
          <view class="date-pickers">
            <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
              <view class="date-picker">
                <text class="date-text">{{startDate || '开始日期'}}</text>
                <view class="arrow-down"></view>
              </view>
            </picker>
            <text class="date-separator">-</text>
            <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
              <view class="date-picker">
                <text class="date-text">{{endDate || '结束日期'}}</text>
                <view class="arrow-down"></view>
              </view>
            </picker>
          </view>
        </view>
      </view>
    </view>

    <!-- Sticky Mask for gap -->
    <view class="sticky-mask"></view>

    <!-- Tabs -->
    <view class="card-module tabs-module sticky-tabs" style="top: 10px;">
      <scroll-view scroll-x="true" class="tabs" enable-flex="true">
        <view class="tab {{currentTab === 'tab1' ? 'active' : ''}}" bindtap="switchTab" data-tab="tab1">表格</view>
        <view class="tab {{currentTab === 'tab2' ? 'active' : ''}}" bindtap="switchTab" data-tab="tab2">饼图分析</view>
        <view class="tab {{currentTab === 'tab3' ? 'active' : ''}}" bindtap="switchTab" data-tab="tab3">活动趋势</view>
        <view class="tab {{currentTab === 'tab4' ? 'active' : ''}}" bindtap="switchTab" data-tab="tab4">偏差分析</view>
      </scroll-view>
    </view>

    <view class="tab-content">
      <!-- Tab 1: Table -->
      <view class="tab-panel" wx:if="{{currentTab === 'tab1'}}">
        <view class="mega-sticky-mask"></view>
        <view class="filter-section">
          <view class="filter-btn {{showPlan ? 'active' : ''}}" bindtap="toggleFilter" data-type="plan">
            <text class="checkbox {{showPlan ? 'checked' : ''}}"></text> 计划
          </view>
          <view class="filter-btn {{showActual ? 'active' : ''}}" bindtap="toggleFilter" data-type="actual">
            <text class="checkbox {{showActual ? 'checked' : ''}}"></text> 实际
          </view>
        </view>

        <view class="analysis-table">
          <block wx:if="{{mergedRecords.length > 0}}">
            <block wx:if="{{!isMultiDay}}">
              <view class="table-container">
                <view class="table-header-bg"></view>
                <view class="table-header">
                  <view class="th time-col">时间</view>
                  <view class="th data-col" wx:if="{{showPlan}}">计划</view>
                  <view class="th data-col" wx:if="{{showActual}}">实际</view>
                </view>
                <view class="table-body">
                  <view class="tr" wx:for="{{mergedRecords}}" wx:key="index" style="height: {{item.slotCount >= 6 ? item.slotCount * 8 : item.slotCount* 16}}px;">
                    <view class="td time-col">{{item.timeLabel}}</view>
                    <view class="td data-col cell" wx:if="{{showPlan}}" style="background-color: {{item.plan ? item.plan.color : ''}}">
                      <text class="cell-text" wx:if="{{item.plan}}">{{item.plan.typeName}}</text>
                    </view>
                    <view class="td data-col cell" wx:if="{{showActual}}" style="background-color: {{item.actual ? item.actual.color : ''}}">
                      <text class="cell-text" wx:if="{{item.actual}}">{{item.actual.typeName}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>

            <block wx:if="{{isMultiDay}}">
              <view class="table-container">
                <view class="table-header-bg"></view>
                <scroll-view scroll-x class="multi-day-header-scroll" scroll-left="{{multiDayScrollLeft}}" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{false}}">
                  <view class="multi-day-table-content" style="width: {{90 + multiDayColumns.length * 80}}px; min-width: 100%;">
                    <view class="table-header multi-day-header">
                      <view class="th time-col">时间</view>
                      <view class="th data-col multi-day-col" wx:for="{{multiDayColumns}}" wx:key="dateStr">{{item.label}}</view>
                    </view>
                  </view>
                </scroll-view>

                <scroll-view scroll-x class="multi-day-scroll" bindscroll="onMultiDayScroll" scroll-left="{{multiDayScrollLeft}}" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{false}}">
                  <view class="multi-day-table-content" style="width: {{90 + multiDayColumns.length * 80}}px; min-width: 100%;">
                    <view class="table-body">
                      <view class="tr" wx:for="{{mergedRecords}}" wx:key="index" style="height: {{item.slotCount >= 6 ? item.slotCount * 8 : item.slotCount* 16}}px;">
                        <view class="td time-col">{{item.timeLabel}}</view>
                        <view class="td data-col cell multi-day-col" wx:for="{{item.daysData}}" wx:for-item="dayItem" wx:key="dateStr" style="background-color: {{dayItem.data ? dayItem.data.color : ''}}">
                          <text class="cell-text" wx:if="{{dayItem.data}}">{{dayItem.data.typeName}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                </scroll-view>
              </view>
            </block>
          </block>

          <view class="empty-tip" wx:if="{{mergedRecords.length === 0}}">暂无数据</view>
        </view>
      </view>

      <!-- Tab 2: Pie Chart Analysis -->
      <view class="tab-panel" wx:if="{{currentTab === 'tab2'}}">
        <view class="mega-sticky-mask"></view>
        <view class="filter-section">
          <view class="filter-btn {{showTime ? 'active' : ''}}" bindtap="togglePieFilter" data-type="time">
            <text class="checkbox {{showTime ? 'checked' : ''}}"></text> 时间
          </view>
          <view class="filter-btn {{showPercentage ? 'active' : ''}}" bindtap="togglePieFilter" data-type="percentage">
            <text class="checkbox {{showPercentage ? 'checked' : ''}}"></text> 占比
          </view>
        </view>

        <view class="pie-charts-wrapper">
          <view class="chart-section">
            <view class="chart-title">计划时间占比</view>
            <view class="pie-chart" style="background: {{planPieGradient}}"></view>
            <view class="legend">
              <view class="legend-item" wx:for="{{planStats}}" wx:key="typeCode">
                <view class="color-dot" style="background-color: {{item.color}}"></view>
                <text>{{item.displayLabel}}</text>
              </view>
            </view>
          </view>
          
          <view class="chart-section">
            <view class="chart-title">实际时间占比</view>
            <view class="pie-chart" style="background: {{actualPieGradient}}"></view>
            <view class="legend">
              <view class="legend-item" wx:for="{{actualStats}}" wx:key="typeCode">
                <view class="color-dot" style="background-color: {{item.color}}"></view>
                <text>{{item.displayLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="stats-list">
          <view class="stats-title">统计列表</view>
          <view class="stats-card">
            <view class="stats-row">总体达成率: <text class="highlight">{{overallCompletionRate}}%</text></view>
            <view class="stats-row">新增事项占整天比例: <text class="highlight">{{newItemsPercentage}}%</text></view>
          </view>
          <view class="stats-card" wx:if="{{newItemsStats.length > 0}}">
            <view class="stats-subtitle">新增事项明细</view>
            <view class="stats-item" wx:for="{{newItemsStats}}" wx:key="typeCode">
              <text>{{item.typeName}}</text>
              <text>{{item.hours}}h ({{item.percentage}}%)</text>
            </view>
          </view>
          <view class="stats-card">
            <view class="stats-subtitle">各事项完成率</view>
            <view class="stats-item" wx:for="{{completionStats}}" wx:key="typeCode">
              <text>{{item.typeName}}</text>
              <text>{{item.completionRate}}% ({{item.actualHours}}h/{{item.plannedHours}}h)</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Tab 3: Trend Chart -->
      <view class="tab-panel" wx:if="{{currentTab === 'tab3'}}">
        <view class="mega-sticky-mask"></view>
        <view class="filter-section">
          <view class="filter-btn {{trendShowPlan ? 'active' : ''}}" bindtap="toggleTrendFilter" data-type="plan">
            <text class="checkbox {{trendShowPlan ? 'checked' : ''}}"></text> 计划
          </view>
          <view class="filter-btn {{trendShowActual ? 'active' : ''}}" bindtap="toggleTrendFilter" data-type="actual">
            <text class="checkbox {{trendShowActual ? 'checked' : ''}}"></text> 实际
          </view>
        </view>
        <view class="trend-module-card">
          <scroll-view scroll-x class="trend-types-scroll">
            <view class="trend-types-section">
              <view class="trend-type-tag {{isAllTrendTypesSelected ? 'active' : ''}}" 
                    bindtap="toggleAllTrendTypes" 
                    style="background-color: {{isAllTrendTypesSelected ? '#000' : '#f0f0f0'}}; color: {{isAllTrendTypesSelected ? '#fff' : '#666'}}">
                全选
              </view>
              <view class="trend-type-tag {{item.selected ? 'active' : ''}}" 
                    wx:for="{{trendAvailableTypes}}" 
                    wx:key="typeCode"
                    bindtap="toggleTrendType" 
                    data-code="{{item.typeCode}}"
                    style="background-color: {{item.selected ? item.color : '#f0f0f0'}}; color: {{item.selected ? '#fff' : '#666'}}">
                {{item.typeName}}
              </view>
            </view>
          </scroll-view>
        </view>
        <!-- Trend Chart Settings -->
        <view class="trend-module-card trend-settings">
          <view class="setting-btn {{trendShowBar ? 'active' : ''}}" bindtap="toggleTrendDisplay" data-type="bar">
            <text class="checkbox {{trendShowBar ? 'checked' : ''}}"></text> 柱状图
          </view>
          <view class="setting-btn {{trendShowLine ? 'active' : ''}}" bindtap="toggleTrendDisplay" data-type="line">
            <text class="checkbox {{trendShowLine ? 'checked' : ''}}"></text> 累计折线图
          </view>
          <view class="setting-btn {{trendShowMultiLine ? 'active' : ''}}" bindtap="toggleTrendDisplay" data-type="multiline">
            <text class="checkbox {{trendShowMultiLine ? 'checked' : ''}}"></text> 多折线图
          </view>
        </view>

        <view class="trend-chart-container">
          <view class="trend-y-axis">
            <view class="trend-y-label" wx:for="{{trendYLabels}}" wx:key="*this">{{item}}</view>
          </view>
          <scroll-view scroll-x class="trend-chart-scroll">
            <view class="trend-chart-content" style="width: {{trendDates.length * trendDayWidth}}px;">
              <!-- Grid lines -->
              <view class="trend-grid-line" wx:for="{{trendYLabels}}" wx:key="*this" style="bottom: {{(item / trendMaxY) * 100}}%"></view>
              
              <!-- Bars -->
              <view class="trend-bar-group" wx:for="{{trendChartData}}" wx:key="date" style="width: {{trendDayWidth}}px;">
                <view class="trend-bars" wx:if="{{trendShowBar}}">
                  <!-- Plan Stacked Bar -->
                  <view wx:if="{{trendShowPlan}}" class="trend-bar plan-bar">
                    <view wx:for="{{item.planSegments}}" wx:for-item="seg" wx:key="typeCode" 
                          class="trend-segment" 
                          style="height: {{(seg.hours / trendMaxY) * 100}}%; background-color: {{seg.color}};">
                    </view>
                  </view>
                  <!-- Actual Stacked Bar -->
                  <view wx:if="{{trendShowActual}}" class="trend-bar actual-bar">
                    <view wx:for="{{item.actualSegments}}" wx:for-item="seg" wx:key="typeCode" 
                          class="trend-segment" 
                          style="height: {{(seg.hours / trendMaxY) * 100}}%; background-color: {{seg.color}};">
                    </view>
                  </view>
                </view>
                <view class="trend-x-label">{{item.shortDate}}</view>
              </view>

              <!-- Line Chart overlay (Canvas/SVG replacement using simple positioning) -->
              <view class="trend-line-chart" wx:if="{{trendShowLine || trendShowMultiLine}}">
                <!-- Cumulative Lines -->
                <block wx:if="{{trendShowLine}}">
                  <!-- Plan Line Connections -->
                  <view wx:if="{{trendShowPlan}}" class="line-connection plan-line" 
                        wx:for="{{trendPlanLines}}" wx:key="index"
                        style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; transform: rotate({{item.angle}}deg);">
                  </view>

                  <!-- Actual Line Connections -->
                  <view wx:if="{{trendShowActual}}" class="line-connection actual-line" 
                        wx:for="{{trendActualLines}}" wx:key="index"
                        style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; transform: rotate({{item.angle}}deg);">
                  </view>
                </block>

                <!-- Multi Lines (Individual Categories) -->
                <block wx:if="{{trendShowMultiLine}}">
                  <block wx:for="{{trendMultiLines}}" wx:key="typeCode" wx:for-item="multiLine">
                    <view class="line-connection" 
                          wx:for="{{multiLine.lines}}" wx:for-item="lineItem" wx:key="index"
                          style="background-color: {{multiLine.color}}; left: {{lineItem.left}}px; top: {{lineItem.top}}px; width: {{lineItem.width}}px; transform: rotate({{lineItem.angle}}deg);">
                    </view>
                    <!-- Optional dots for multiline -->
                    <view class="line-dot"
                          wx:for="{{trendChartData}}" wx:for-item="dataItem" wx:key="date"
                          wx:if="{{dataItem.typeHours[multiLine.typeCode] !== undefined}}"
                          style="background-color: {{multiLine.color}}; left: {{index * trendDayWidth + trendDayWidth / 2}}px; bottom: {{(dataItem.typeHours[multiLine.typeCode] / trendMaxY) * 100}}%; transform: translate(-2px, 2px); width: 4px; height: 4px; border: none;">
                    </view>
                  </block>
                </block>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- Tab 4 Placeholders -->
      <view class="tab-panel placeholder" wx:if="{{currentTab === 'tab4'}}">
        <view class="developing-text">正在开发中...</view>
      </view>
      </view>
    </view>
  </scroll-view>
</view>
