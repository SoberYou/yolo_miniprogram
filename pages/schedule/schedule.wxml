<!-- pages/schedule/schedule.wxml -->
<view class="container" style="padding-top: {{navBarHeight + statusBarHeight}}px; box-sizing: border-box; --nav-height: {{navBarHeight + statusBarHeight}}px;">
  <!-- Custom Header -->
  <view class="custom-header" style="height: {{navBarHeight + statusBarHeight}}px; padding-top: {{statusBarHeight}}px; box-sizing: border-box;">
    <view class="header-content" style="height: {{menuButtonHeight}}px; line-height: {{menuButtonHeight}}px; margin-top: {{menuButtonTop - statusBarHeight}}px;">
      <text class="app-title">YOU ONLY LIVE ONCE</text>
    </view>
  </view>

  <view class="main-content" style="padding-bottom: 10px;">
    <!-- Mask to hide scrolling content in the gap -->
    <view class="sticky-mask" wx:if="{{isFixed}}" style="top: {{navBarHeight + statusBarHeight}}px;"></view>
    
    <scroll-view class="scroll-area" scroll-y bindscroll="onScroll">
    
    <view class="top-modules-row" id="topControlsWrap">
      <!-- Date Module (Left) -->
      <view class="card-module date-module">
        <view class="date-section">
          <view class="left-controls">
            <picker mode="date" value="{{date}}" bindchange="onDateChange">
              <view class="date-picker">
                <text class="date-text">{{date}}</text>
                <view class="arrow-down"></view>
              </view>
            </picker>
          </view>
          <view class="quick-dates">
            <view class="quick-btn {{isYesterday ? 'active' : ''}}" bindtap="selectYesterday">昨天</view>
            <view class="quick-btn {{isToday ? 'active' : ''}}" bindtap="selectToday">今天</view>
            <view class="quick-btn {{isTomorrow ? 'active' : ''}}" bindtap="selectTomorrow">明天</view>
          </view>
        </view>
      </view>

      <!-- Config Module (Right) -->
      <view class="card-module config-module" bindtap="goToTypeConfig">
        <text class="icon">⚙️</text>
        <text>活动</text>
      </view>
    </view>

    <!-- Sticky Area -->
    <view class="card-module schedule-table-module">
      <view class="sticky-container {{isFixed ? 'is-fixed' : ''}}" id="stickyArea">
      <!-- Type Selector -->
      <view class="type-section" wx:if="{{activityTypes.length > 0}}">
        <view class="type-selector-wrapper">
          <scroll-view scroll-x="true" class="type-scroll" enable-flex="true">
            <view class="type-list">
              <view 
                class="type-item {{currentType && currentType.id === item.id ? 'selected' : ''}}" 
                wx:for="{{activityTypes}}" 
                wx:key="id"
                bindtap="selectType"
                data-type="{{item}}"
              >
                <view class="type-color" style="background-color: {{item.color}}"></view>
                <text class="type-name">{{item.typeName}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- Table Header -->
      <view class="schedule-table-header-wrap">
        <!-- History Controls -->
        <view class="history-controls">
          <view class="history-left">
            <view class="history-btn" bindtap="resetSleepTime">
              <text class="icon">🌙</text>
              <text>睡眠</text>
            </view>
            <view class="history-btn {{canUndo ? 'active' : 'disabled'}}" bindtap="undo">
              <text class="icon">↩</text>
              <text>撤销</text>
            </view>
            <view class="history-btn {{canRedo ? 'active' : 'disabled'}}" bindtap="redo">
              <text class="icon">↪</text>
              <text>重做</text>
            </view>
          </view>
          <!-- Save Button -->
          <view class="history-btn save-btn active" bindtap="saveSchedule">
            <text class="icon">💾</text>
            <text>保存</text>
          </view>
        </view>
        
        <view class="table-header">
        <view class="th time-col">时间</view>
        <view class="th data-col">计划</view>
        <view class="th data-col">实际</view>
      </view>
      </view>
    </view>

    <!-- Table Body and Action Area -->
    <view class="schedule-table" style="{{isFixed ? 'margin-top: ' + stickyHeight + 'px;' : ''}}">
      
      <view class="table-body">
        <view class="tr" wx:for="{{timeSlots}}" wx:key="index">
          <view class="td time-col">{{item.label}}</view>
          
          <!-- Plan Cell -->
          <view 
            class="td data-col cell editable" 
            bindtap="onCellTap" 
            bindlongpress="onCellLongPress"
            data-index="{{item.index}}" 
            data-col="plan"
          >
            <block wx:if="{{planMap[item.index] && planMap[item.index].length > 0}}">
              <view 
                class="sub-cell" 
                wx:for="{{planMap[item.index]}}" 
                wx:for-item="seg" 
                wx:key="startTime"
                style="background-color: {{seg.typeObj.color}}; top: {{seg.topPercent}}%; height: {{seg.heightPercent}}%;"
              >
                <text class="cell-text" wx:if="{{seg.heightPercent > 20}}">{{seg.typeObj.typeName}}</text>
              </view>
            </block>
          </view>
          
          <!-- Actual Cell -->
          <view 
            class="td data-col cell editable" 
            bindtap="onCellTap" 
            bindlongpress="onCellLongPress"
            data-index="{{item.index}}" 
            data-col="actual"
          >
            <block wx:if="{{actualMap[item.index] && actualMap[item.index].length > 0}}">
              <view 
                class="sub-cell" 
                wx:for="{{actualMap[item.index]}}" 
                wx:for-item="seg" 
                wx:key="startTime"
                style="background-color: {{seg.typeObj.color}}; top: {{seg.topPercent}}%; height: {{seg.heightPercent}}%;"
              >
                <text class="cell-text" wx:if="{{seg.heightPercent > 20}}">{{seg.typeObj.typeName}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
    <!-- End schedule-table-module -->
    </view>

    <view style="height: 60px;"></view>
    </scroll-view>
  </view>

  <!-- Split Time Modal -->
  <view class="modal-overlay" wx:if="{{showSplitModal}}" bindtap="closeSplitModal">
    <view class="modal-content split-modal" catchtap="stopPropagation">
      <view class="modal-header">细分时间段 - {{splitSlotLabel}}</view>
      <view class="modal-body">
        <view class="split-list">
          <view class="split-item" wx:for="{{splitSegments}}" wx:key="index">
            <picker mode="time" value="{{item.startTime}}" start="{{splitSlotStart}}" end="{{splitSlotEnd}}" bindchange="onSplitStartChange" data-index="{{index}}">
              <view class="time-picker">{{item.startTime}}</view>
            </picker>
            <text class="split-to">至</text>
            <picker mode="time" value="{{item.endTime}}" start="{{splitSlotStart}}" end="{{splitSlotEnd}}" bindchange="onSplitEndChange" data-index="{{index}}">
              <view class="time-picker">{{item.endTime}}</view>
            </picker>
            
            <picker mode="selector" range="{{activityTypes}}" range-key="typeName" bindchange="onSplitTypeChange" data-index="{{index}}">
              <view class="type-picker" style="background-color: {{item.typeObj ? item.typeObj.color : '#eee'}}; color: {{item.typeObj ? '#fff' : '#333'}}">{{item.typeObj ? item.typeObj.typeName : '选择类型'}}</view>
            </picker>
            
            <view class="del-btn" bindtap="removeSplitSegment" data-index="{{index}}">×</view>
          </view>
        </view>
        <view class="add-split-btn" bindtap="addSplitSegment">+ 新增时间段</view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closeSplitModal">取消</view>
        <view class="btn-confirm" bindtap="confirmSplit">确定</view>
      </view>
    </view>
  </view>
</view>