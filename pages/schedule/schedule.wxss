/** pages/schedule/schedule.wxss */
page {
  background-color: #f5f6f8;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.card-module {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin: 0 16px 16px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}


/* Split Modal */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content.split-modal {
  width: 90%;
  max-width: 340px;
  background-color: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.modal-header {
  padding: 16px;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  border-bottom: 1px solid #eee;
}

.modal-body {
  padding: 16px;
  max-height: 50vh;
  overflow-y: auto;
}

.split-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.split-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.time-picker {
  padding: 4px 8px;
  background-color: #f5f5f5;
  border-radius: 4px;
  font-size: 14px;
  min-width: 46px;
  text-align: center;
}

.split-to {
  font-size: 12px;
  color: #666;
}

.type-picker {
  flex: 1;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 14px;
  text-align: center;
  min-width: 60px;
}

.del-btn {
  width: 24px;
  height: 24px;
  line-height: 22px;
  text-align: center;
  color: #ff4d4f;
  border: 1px solid #ff4d4f;
  border-radius: 50%;
  font-size: 16px;
}

.add-split-btn {
  margin-top: 16px;
  padding: 10px;
  text-align: center;
  color: #007aff;
  background-color: #e6f7ff;
  border-radius: 8px;
  font-size: 14px;
}

.modal-footer {
  display: flex;
  border-top: 1px solid #eee;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 16px;
  text-align: center;
  font-size: 16px;
}

.btn-cancel {
  color: #666;
  border-right: 1px solid #eee;
}

.btn-confirm {
  color: #007aff;
  font-weight: bold;
}

.container {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

/* Header */
.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 100;
}

.header-content {
  display: flex;
  align-items: center;
  padding-left: 24px; /* Align with content */
  position: relative;
}

.app-title {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #000000;
}

.main-content {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.scroll-area {
  flex: 1;
  height: 100%;
  width: 100%;
  min-height: 0;
}

.schedule-table-module {
  margin: 0 16px 16px;
  padding: 0;
  overflow: hidden;
}

.sticky-container {
  background-color: #fff;
  padding-top: 2px;
  width: 100%;
  box-sizing: border-box;
  transition: box-shadow 0.3s ease;
}

.sticky-container.is-fixed {
  position: fixed;
  top: calc(var(--nav-height, 47px) + 10px);
  left: 16px;
  right: 16px;
  width: auto;
  z-index: 100;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  border-radius: 12px 12px 0 0;
}

.sticky-mask {
  position: fixed;
  left: 0;
  right: 0;
  height: 10px;
  background-color: #f5f6f8;
  z-index: 99;
}

.schedule-table-header-wrap {
  padding: 16px 16px 0;
  background-color: #fff;
  box-sizing: border-box;
}

/* Top Modules Row */
.top-modules-row {
  display: flex;
  margin: 16px;
  gap: 12px;
}

/* Date Module */
.date-module {
  flex: 1;
  margin: 0;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.date-section {
  display: flex;
  width: 100%;
  justify-content: space-between;
  align-items: center;
  gap: 4px;
}

/* Config Module */
.config-module {
  margin: 0;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  transition: opacity 0.2s;
}

.config-module .icon {
  margin-right: 4px;
  font-size: 14px;
}

.config-module:active {
  opacity: 0.7;
}

.left-controls {
  display: flex;
  align-items: center;
}

.date-picker {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 5px 8px;
  border-radius: 16px;
  white-space: nowrap;
}

.date-text {
  font-size: 13px;
  font-weight: 600;
  color: #333;
  margin-right: 4px;
}

.arrow-down {
  width: 0;
  height: 0;
  border-left: 3px solid transparent;
  border-right: 3px solid transparent;
  border-top: 4px solid #333;
}

.quick-dates {
  display: flex;
  gap: 4px;
  flex-wrap: nowrap;
  justify-content: flex-end;
  overflow: hidden;
}

.quick-btn {
  font-size: 12px;
  color: #666;
  background-color: #f5f5f5;
  padding: 5px 6px;
  border-radius: 16px;
  transition: all 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
}

.quick-btn.active {
  background-color: #000;
  color: #fff;
}



/* Type Selector */
.type-section {
  padding: 0;
  border-bottom: 1px solid #eee;
}

.type-selector-wrapper {
  padding: 6px 12px;
}

.type-scroll {
  width: 100%;
}

.type-list {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  height: 64px; /* Approx height for 2 rows */
  gap: 8px;
  align-content: flex-start;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 4px 10px;
  background-color: #fff;
  border-radius: 20px;
  border: 1px solid #eee;
  transition: all 0.3s;
  flex-shrink: 0;
}

.type-item.selected {
  border-color: #000;
  background-color: #fff;
}

.type-color {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  margin-right: 6px;
}

.type-name {
  font-size: 13px;
  color: #333;
}

/* Table */
.schedule-table {
  padding: 0 16px 20px;
  background-color: #fff;
  box-sizing: border-box;
}

.history-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.history-left {
  display: flex;
  gap: 16px;
}

.history-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  color: #333;
  padding: 4px 8px;
  border-radius: 4px;
  background-color: #f5f5f5;
  transition: all 0.2s;
}

.history-btn .icon {
  font-size: 16px;
  font-weight: bold;
}

.history-btn.active:active {
  opacity: 0.7;
  background-color: #e8e8e8;
}

.history-btn.disabled {
  color: #ccc;
  background-color: #f9f9f9;
}

.table-header {
  display: flex;
  background-color: #fafafa;
  border-radius: 8px 8px 0 0;
  border: 1px solid #eee;
  border-bottom: none;
}

.th {
  padding: 10px 0;
  font-size: 13px;
  color: #999;
  text-align: center;
  font-weight: 500;
  box-sizing: border-box;
}

.time-col {
  width: 90px;
  flex-shrink: 0;
  border-right: 1px solid #eee;
  box-sizing: border-box;
}

.data-col {
  flex: 1;
  border-right: 1px solid #eee;
  box-sizing: border-box;
}

.data-col:last-child {
  border-right: none;
}



.table-body {
  border: 1px solid #eee;
  border-radius: 0 0 8px 8px;
  overflow: hidden;
}

.tr {
  display: flex;
  border-bottom: 1px solid #eee;
}

.tr:last-child {
  border-bottom: none;
}

.td {
  padding: 8px 4px;
  font-size: 12px;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.cell {
  position: relative;
  transition: background-color 0.2s;
  cursor: pointer;
  padding: 0 !important;
}

.cell.editable:active {
  opacity: 0.7;
}

.sub-cell {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.sub-cell:not(:first-child) {
  border-top: 1px solid rgba(255,255,255,0.3);
}

.cell-text {
  color: #fff;
  font-weight: 500;
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  word-break: break-all;
}

/* Action Bar */
.action-bar {
  padding: 20px;
  display: flex;
  justify-content: center;
}

.btn-save {
  width: 100% !important;
  background-color: #000;
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  border-radius: 8px;
  padding: 12px 0;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save::after {
  border: none;
}